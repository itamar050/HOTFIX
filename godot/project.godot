; Engine configuration file.
; HOTFIX! Nexus Meltdown: Godot build. Main scene = the 16-bit brawler (main.tscn, scripts/).
; The paused 8-bit platformer is game8/ (run res://game8/main.tscn; it was made for 400x240).

config_version=5

[application]

config/name="HOTFIX! Nexus Meltdown - test build"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="viewport"
window/stretch/aspect="keep"
window/stretch/scale_mode="integer"

[physics]

common/physics_ticks_per_second=60

[rendering]

textures/canvas_textures/default_texture_filter=0
textures/vram_compression/import_etc2_astc=true
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true
