## 3x5 pixel font drawn with rectangles (the 8-bit HUD and floating texts).
extends RefCounted

const G := {
	"A": "010101111101101", "B": "110101110101110", "C": "011100100100011", "D": "110101101101110",
	"E": "111100110100111", "F": "111100110100100", "G": "011100101101011", "H": "101101111101101",
	"I": "111010010010111", "J": "001001001101010", "K": "101101110101101", "L": "100100100100111",
	"M": "101111111101101", "N": "111101101101101", "O": "010101101101010", "P": "110101110100100",
	"Q": "010101101111011", "R": "110101110101101", "S": "011100010001110", "T": "111010010010010",
	"U": "101101101101111", "V": "101101101101010", "W": "101101101111101", "X": "101101010101101",
	"Y": "101101010010010", "Z": "111001010100111",
	"0": "111101101101111", "1": "010110010010111", "2": "110001010100111", "3": "110001010001110",
	"4": "101101111001001", "5": "111100110001110", "6": "011100110101010", "7": "111001010010010",
	"8": "010101010101010", "9": "010101011001110",
	"!": "010010010000010", "?": "110001010000010", "$": "011110010011110", "+": "000010111010000",
	"-": "000000111000000", ":": "000010000010000", ".": "000000000000010", ",": "000000000010100",
	"'": "010010000000000", ">": "100010001010100", "<": "001010100010001", "/": "001001010100100",
	"(": "010100100100010", ")": "010001001001010", "%": "101001010100101", "=": "000111000111000",
}


static func width(s: String, sc := 1) -> int:
	return (s.length() * 4 - 1) * sc


static func text(ci: CanvasItem, p: Vector2, s: String, c: Color, sc := 1, shadow := true) -> void:
	var x := int(p.x)
	var y := int(p.y)
	for ch in s.to_upper():
		var g: String = G.get(ch, "")
		if g != "":
			for j in 5:
				for i in 3:
					if g[j * 3 + i] == "1":
						if shadow:
							ci.draw_rect(Rect2(x + i * sc + sc, y + j * sc + sc, sc, sc), Color(0.05, 0.04, 0.1))
						ci.draw_rect(Rect2(x + i * sc, y + j * sc, sc, sc), c)
		x += 4 * sc


static func centered(ci: CanvasItem, cx: float, y: float, s: String, c: Color, sc := 1) -> void:
	text(ci, Vector2(cx - width(s, sc) / 2.0, y), s, c, sc)
